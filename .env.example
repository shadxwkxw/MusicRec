# Скопируй в .env (make env) и поменяй значения. .env не попадает в git.
# Переменные, уже заданные в окружении, важнее значений из файла.

# Доступ к API: изменяющие запросы требуют заголовок X-API-Key.
# Пусто — без проверки (только для локальной разработки). Сгенерировать: openssl rand -hex 32
API_KEY=
# API_PROTECT_READS=false            # true — ключ нужен и для рекомендаций, поиска, списков
# CORS_ORIGINS=https://app.example.com  # домены веб-приложения через запятую

# Логи: уровень и формат (JSON — одна строка на запись, для сборщиков логов)
# LOG_LEVEL=INFO
# LOG_JSON=false

# Источник признаков для поиска похожих: librosa | embedding
# (embedding: make install-embeddings, make batch-embed, затем rebuild)
FEATURE_SOURCE=librosa

# База приложения. По умолчанию — локальная SQLite (data/recommender.db).
# Для Postgres из docker-compose с хоста:
# DB_URL=postgresql+asyncpg://recommender:change-me@localhost:5432/recommender

# Postgres в docker-compose (берутся при первом создании volume postgres-data)
POSTGRES_USER=recommender
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recommender
# Порт Postgres из docker-compose на хосте (поменяй, если 5432 уже занят локальным Postgres)
POSTGRES_HOST_PORT=5432
# Порт online-сервиса из docker-compose на хосте (если 8000 занят, например make run)
# ONLINE_HOST_PORT=8000

# Хранилище аудио: local (data/audio) или s3 (любое S3-совместимое: AWS, Yandex Object Storage, RustFS, MinIO)
AUDIO_STORAGE=local
# S3_BUCKET=music
# S3_UPLOAD_PREFIX=uploads/          # куда сервис кладёт загруженные через API треки
# S3_IMPORT_PREFIX=music/            # откуда ежедневный DAG импортирует новую музыку
# S3_INDEX_PREFIX=index/             # версии индекса (faiss.index, *.joblib)
# S3_ARTIFACTS_PREFIX=artifacts/     # выгрузки batch recommend (*.parquet)
# S3_ENDPOINT_URL=                   # пусто — AWS; RustFS из docker-compose с хоста: http://localhost:5050
# S3_CONTAINER_ENDPOINT_URL=         # адрес для контейнеров, если отличается: для RustFS — http://s3:9000
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_HOST_PORT=5050                  # порты RustFS на хосте: API и веб-консоль
# S3_CONSOLE_PORT=9001

# Другой файл конфига вместо configs/config.yaml
# CONFIG_PATH=configs/config.yaml

# Airflow (docker compose --profile airflow, make airflow-up)
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
# Образ batch с torch для шага embed (нужен при FEATURE_SOURCE=embedding)
# BATCH_EXTRAS=embeddings
# Образ online с torch для поиска по тексту (GET /search)
# ONLINE_EXTRAS=embeddings
